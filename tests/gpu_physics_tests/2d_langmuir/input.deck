begin:control
  # 2D Langmuir Wave Test (similar to 1D)
  # Uses density perturbation to drive oscillation
  
  nx = 64
  ny = 8
  
  t_end = 5.0e-12
  
  x_min = 0.0
  x_max = 1.0e-5
  y_min = 0.0
  y_max = 1.25e-6
  
  stdout_frequency = 100
end:control


begin:boundaries
  bc_x_min = periodic
  bc_x_max = periodic
  bc_y_min = periodic
  bc_y_max = periodic
end:boundaries


begin:constant
  n0 = 1.0e24
  Te = 10.0
  perturbation = 0.1
end:constant


begin:species
  name = electron
  charge = -1.0
  mass = 1.0
  
  # Density perturbation in x direction
  number_density = n0 * (1.0 + perturbation * sin(2.0 * pi * x / (x_max - x_min)))
  
  temperature_ev = Te
  
  nparticles_per_cell = 16
end:species


begin:species
  name = ion
  charge = 1.0
  mass = 1836.0
  
  number_density = n0
  temperature_ev = Te / 100.0
  
  nparticles_per_cell = 4
end:species


begin:output
  name = langmuir2d
  
  dt_snapshot = 1.0e-13
  
  grid = always
  ex = always
  ey = always
  jx = always
  jy = always
  
  number_density = always + species
  
  total_energy_sum = always
  field_energy = always
end:output

